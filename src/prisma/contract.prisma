//use prisma-8
enum TournamentStatus {
  @@type("pg/text@1")
  ACTIVE = "ACTIVE"
  PAUSED = "PAUSED"
  ENDED = "ENDED"
}

enum TournamentFormat {
  @@type("pg/text@1")
  SINGLE_ELIMINATION = "SINGLE_ELIMINATION"
  GROUP_STAGE = "GROUP_STAGE"
}

enum TeamStatus {
  @@type("pg/text@1")
  PENDING = "PENDING"
  APPROVED = "APPROVED"
  REJECTED = "REJECTED"
}

enum MatchStatus {
  @@type("pg/text@1")
  PENDING = "PENDING"
  ONGOING = "ONGOING"
  COMPLETED = "COMPLETED"
}

enum MatchType {
  @@type("pg/text@1")
  GROUP_MATCH = "GROUP_MATCH"
  KNOCKOUT_MATCH = "KNOCKOUT_MATCH"
  FINAL = "FINAL"
}

model mixin Timestamps {
  createdAt temporal.createdAtString()
  updatedAt temporal.updatedAtString()
}

model Tournament {
  id              String             @id @default(cuid(2))
  guildId         String
  name            String
  game            String

  format          TournamentFormat

  rules           String?
  rulesURL        String?

  groupCount      Int                @default(0)
  advancePerGroup Int                @default(2)

  registrationEnd TimestamptzString?

  status          TournamentStatus   @default(ACTIVE)

  teams           Team[]
  matches         Match[]
  groups          Group[]

  +Timestamps

  @@map("tournament")
}

model Group {
  id           String     @id @default(cuid(2))
  name         String
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  teams        Team[]
  matches      Match[]

  +Timestamps

  @@map("group")
}

model Team {
  id             String     @id @default(cuid(2))
  name           String
  tag            String?
  tournamentId   String
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  status         TeamStatus @default(PENDING)

  groupId        String?
  group          Group?     @relation(fields: [groupId], references: [id])
  groupPoints    Int        @default(0)

  players        Player[]

  matchesAsTeamA Match[]    @relation("MatchTeamA")
  matchesAsTeamB Match[]    @relation("MatchTeamB")
  roundsWon      Round[]    @relation("RoundWinner")

  +Timestamps

  @@unique([name, tournamentId])
  @@map("team")
}

model Match {
  id           String             @id @default(cuid(2))
  tournamentId String
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  type         MatchType
  name         String
  status       MatchStatus        @default(PENDING)
  startTime    TimestamptzString?

  groupId      String?
  group        Group?             @relation(fields: [groupId], references: [id])

  teamAId      String?
  teamA        Team?              @relation("MatchTeamA", fields: [teamAId], references: [id])
  teamAScore   Int?

  teamBId      String?
  teamB        Team?              @relation("MatchTeamB", fields: [teamBId], references: [id])
  teamBScore   Int?

  winnerId     String? // winnerId = null => draw

  bestOf       Int                @default(3)
  rounds       Round[]

  nextMatchId  String?
  nextMatch    Match?             @relation("BracketTree", fields: [nextMatchId], references: [id])
  prevMatches  Match[]            @relation("BracketTree")

  +Timestamps

  @@map("match")
}

model Round {
  id          String  @id @default(cuid(2))
  matchId     String
  match       Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)

  roundIndex  Int

  winnerId    String?
  winner      Team?   @relation("RoundWinner", fields: [winnerId], references: [id], onDelete: Cascade)

  teamAPoint  Int
  teamBPoint  Int

  screenshoot String
  duration    Int?

  mvpId       String?
  mvp         Player? @relation(fields: [mvpId], references: [id], onDelete: SetNull)

  +Timestamps

  @@map("round")
}

model Player {
  id        String  @id @default(cuid(2))
  ign       String
  discordId String?

  teamId    String
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  isCaptain Boolean @default(false)

  roundsMvp Round[]

  +Timestamps

  @@index([discordId])
  @@map("player")
}
